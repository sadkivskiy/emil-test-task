{
  "name": "emil-test",
  "version": "1.0.0",
  "description": "TypeScript Cucumber API testing framework for Claim Service",
  "type": "module",
  "scripts": {
    "test": "NODE_OPTIONS='--import tsx' cucumber-js",
    "test:lifecycle": "NODE_OPTIONS='--import tsx' cucumber-js --profile lifecycle",
    "test:payouts": "NODE_OPTIONS='--import tsx' cucumber-js --profile payouts",
    "test:list": "NODE_OPTIONS='--import tsx' cucumber-js --profile list",
    "test:swagger": "NODE_OPTIONS='--import tsx' cucumber-js --profile swagger",
    "test:dry": "NODE_OPTIONS='--import tsx' cucumber-js --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check src tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sadkivskiy/emil-test-task.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sadkivskiy/emil-test-task/issues"
  },
  "homepage": "https://github.com/sadkivskiy/emil-test-task#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.6.2",
    "chai": "^6.2.2",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0"
  }
}
